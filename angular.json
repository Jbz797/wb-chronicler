{
  "cli": { "analytics": "384efcfb-fd9b-4f4f-b1f0-5a72b6ef3c7e", "packageManager": "yarn" },
  "version": 1,
  "projects": {
    "wb-chronicler": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "assets": [
              {
                "glob": "**/*",
                "ignore": [
                  "**/.DS_Store",
                  "**/.cache/**",
                  "**/.ruff_cache/**",
                  "**/__pycache__/**",
                  "world/history/map_stats.s3db",
                  "world/history/places.json",
                  "world/saves/*/map.wbox",
                  "world/tools/*/**",
                  "world/tools/ruff.toml"
                ],
                "input": "src/assets",
                "output": "/assets"
              },
              { "glob": "**/*", "input": "./node_modules/@ant-design/icons-angular/src/inline-svg/", "output": "/assets/" },
              { "glob": "scroll-timeline-polyfill.js", "input": "./node_modules/ngx-scrollbar/assets/", "output": "/assets/" }
            ],
            "browser": "src/main.ts",
            "index": "src/index.html",
            "optimization": false,
            "polyfills": ["zone.js"],
            "sourceMap": true,
            "stylePreprocessorOptions": { "includePaths": ["src"] },
            "styles": ["src/theme.less", "src/styles.scss", "node_modules/prism-themes/themes/prism-gruvbox-dark.css"],
            "tsConfig": "tsconfig.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "wb-chronicler:build" }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": { "lintFilePatterns": ["src/**/*.ts", "src/**/*.html"] }
        }
      }
    }
  }
}
