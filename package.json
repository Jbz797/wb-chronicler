{
  "name": "wb-chronicler",
  "version": "0.0.0",
  "description": "Tolkien-style chronicle for WorldBox playthroughs — Claude Code turns saves into narrative chapters, rendered in a parchment-themed Angular reader.",
  "keywords": [
    "ai-agent",
    "angular",
    "anthropic",
    "claude",
    "claude-code",
    "narrative",
    "python",
    "tolkien",
    "typescript",
    "worldbox",
    "worldbuilding"
  ],
  "author": {
    "name": "Jbz797"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jbz797/wb-chronicler.git"
  },
  "bugs": {
    "url": "https://github.com/Jbz797/wb-chronicler/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build",
    "lint": "ng lint && stylelint \"src/**/*.scss\" && prettier --check \"src/**/*.html\"",
    "lint:fix": "ng lint --fix && stylelint --fix \"src/**/*.scss\" && prettier --write \"src/**/*.html\"",
    "start": "concurrently --kill-others --names \"ng,watch\" -c \"green,cyan\" \"ng serve\" \"node scripts/watch-saves.mjs\"",
    "start:prod": "concurrently --kill-others --names \"ng,watch\" -c \"green,cyan\" \"ng serve --configuration production\" \"node scripts/watch-saves.mjs\""
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@ngx-translate/core": "18.1.0",
    "marked": "18.2.1",
    "ng-zorro-antd": "22.2.1",
    "ngx-markdown": "22.1.1",
    "ngx-scrollbar": "^19.1.5",
    "prism-themes": "1.9.0",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@angular/language-service": "22.3.0",
    "chokidar": "6.0.0",
    "concurrently": "10.0.7",
    "eslint-config-angular-strict": "22.8.3",
    "less": "4.9.1",
    "prettier": "3.10.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard-scss": "18.0.0",
    "stylelint-prettier": "5.1.0",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.19.0+sha512.2cb9e5a36f7f11f2bc6ff444830d87368d419e0d83b6a0fb6077d3e6fed0f476c9514dff4ba4d84b049bd34ef32954e550f264ad2fbbfebcba6c89e869530bba"
}
