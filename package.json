{
  "name": "wb-chronicler",
  "version": "0.0.0",
  "description": "Tolkien-style chronicle for WorldBox playthroughs — Claude Code turns saves into narrative chapters, rendered in a parchment-themed Angular reader.",
  "keywords": [
    "ai-agent",
    "angular",
    "anthropic",
    "claude",
    "claude-code",
    "narrative",
    "python",
    "tolkien",
    "typescript",
    "worldbox",
    "worldbuilding"
  ],
  "author": {
    "name": "Jbz797"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jbz797/wb-chronicler.git"
  },
  "bugs": {
    "url": "https://github.com/Jbz797/wb-chronicler/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "ng build",
    "lint": "ng lint && stylelint \"src/**/*.scss\" && prettier --check \"src/**/*.html\"",
    "lint:fix": "ng lint --fix && stylelint --fix \"src/**/*.scss\" && prettier --write \"src/**/*.html\"",
    "start": "concurrently --kill-others --names \"ng,watch\" -c \"green,cyan\" \"ng serve\" \"node scripts/watch-saves.mjs\"",
    "start:prod": "concurrently --kill-others --names \"ng,watch\" -c \"green,cyan\" \"ng serve --configuration production\" \"node scripts/watch-saves.mjs\""
  },
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@ngx-translate/core": "18.0.0",
    "marked": "18.0.14",
    "ng-zorro-antd": "22.1.1",
    "ngx-markdown": "22.1.0",
    "ngx-scrollbar": "^19.1.5",
    "prism-themes": "1.9.0",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/language-service": "22.2.1",
    "chokidar": "5.0.0",
    "concurrently": "10.0.5",
    "eslint-config-angular-strict": "22.3.9",
    "less": "4.9.1",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.0.3",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
